{
  "ConnectionStrings": {
    "Auth": "Data Source=App_Data/sample-auth.db"
  },
  "Auth": {
    "Issuer": "SharpAccess.SampleApi",
    "Audience": "SharpAccess.SampleClients",
    "PasswordPepperVersion": "v1",
    "ReturnRefreshTokenInResponseBody": false,
    "SeedTestAdmin": false,
    "RateLimits": {
      "PartitionKey": "development-only-rate-limit-partition-key"
    },
    "OpenIdConnect": {
      "Providers": {
        "google": {
          "Enabled": false,
          "ClientId": "",
          "ClientSecret": ""
        }
      }
    },
    "Features": {
      "PasswordAuthentication": true,
      "Registration": true,
      "PasswordReset": true,
      "RefreshTokens": true,
      "Administration": true,
      "Tenancy": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Cors": {
    "AllowedOrigins": []
  }
}

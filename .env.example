# Runtime and public origin
APP_ENV=Development
APP_PORT=5000
APP_BASE_URL=http://localhost:5000

# Reverse proxy and transport security
APP_FORWARDED_HEADERS_LIMIT=1
APP_FORWARDED_HEADERS_KNOWN_PROXIES=

# Data Protection keys for Production
APP_DATA_PROTECTION_APP_NAME=SharpAccess.SampleApi
APP_DATA_PROTECTION_KEYS_DIRECTORY=
APP_DATA_PROTECTION_CERTIFICATE_PATH=
APP_DATA_PROTECTION_CERTIFICATE_PASSWORD=

# JWT and session security
APP_JWT_ISSUER=SharpAccess.SampleApi
APP_JWT_AUDIENCE=SharpAccess.SampleClients
APP_JWT_KEY=replace-with-at-least-32-random-bytes
APP_JWT_ACCESS_TOKEN_MINUTES=60
APP_FRESH_AUTHENTICATION_MINUTES=10
APP_REFRESH_TOKEN_DAYS=30
APP_REFRESH_TOKEN_HASH_KEY=replace-with-a-different-32-byte-random-key
APP_PASSWORD_PEPPER=replace-with-at-least-16-random-bytes
APP_PASSWORD_PEPPER_VERSION=v1
APP_REQUIRE_COOKIE_CONFIRMATION_HEADER=false
APP_COOKIE_CONFIRMATION_HEADER_NAME=X-SharpAccess-CSRF
APP_COOKIE_CONFIRMATION_HEADER_VALUE=1

# Abuse protection
APP_RATE_LIMIT_LOGIN_PER_MINUTE=10
APP_RATE_LIMIT_PARTITION_KEY=replace-with-a-dedicated-32-byte-random-key
APP_LOCKOUT_FAILED_ATTEMPTS=5
APP_LOCKOUT_MINUTES=15

# Persistence
AUTH_DATABASE_PROVIDER=sqlite
AUTH_CONNECTION_STRING=Data Source=App_Data/sample-auth.db

# Optional PostgreSQL provider configuration
SharpAccess__Postgres__ConnectionString=Host=localhost;Database=sharpaccess_auth;Username=sharpaccess;Password=change-me

# Production email sender settings; the sample requires a host-provided IEmailSender outside Development/Test
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Google-compatible entry in the keyed OpenID Connect provider configuration
OAUTH_GOOGLE_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Explicit local/test administrator seed only
APP_SEED_ADMIN=false
APP_SEED_ADMIN_EMAIL=admin@test.local
APP_SEED_ADMIN_PASSWORD=replace-with-a-local-test-password

# Optional endpoint groups; all package defaults are false
Auth__Features__PasswordAuthentication=true
Auth__Features__Registration=true
Auth__Features__PasswordReset=true
Auth__Features__RefreshTokens=true
Auth__Features__Administration=true
Auth__Features__Tenancy=true

# Additional sample tuning
Auth__ReturnRefreshTokenInResponseBody=false
Auth__RequireCsrfHeaderForCookieRefreshRequests=false
Auth__CsrfHeaderName=X-SharpAccess-CSRF
Auth__CsrfHeaderValue=1
Auth__EmailVerificationMinutes=60
Auth__PasswordResetMinutes=30
Auth__RateLimits__RegisterPerMinute=5
Auth__RateLimits__RefreshPerMinute=30
Auth__RateLimits__PasswordResetPerMinute=5
Auth__RateLimits__EmailVerificationPerMinute=10
Auth__RateLimits__OAuthPerMinute=20
Cors__AllowedOrigins__0=http://localhost:5000

<Project InitialTargets="ValidateSharpAccessStablePackageIdentity">
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true' or '$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <Target
    Name="ValidateSharpAccessStablePackageIdentity"
    Condition="'$(IsPackable)' == 'true'">
    <PropertyGroup>
      <SharpAccessPackageIsPrerelease>$([System.String]::Copy('$(PackageVersion)').Contains('-'))</SharpAccessPackageIsPrerelease>
    </PropertyGroup>
    <Error
      Condition="'$(SharpAccessPackageIsPrerelease)' != 'True' and '$(SharpAccessStableRelease)' != 'true'"
      Text="Stable SharpAccess packages require the explicit SharpAccessStableRelease=true release-only override." />
    <Error
      Condition="'$(SharpAccessPackageIsPrerelease)' != 'True' and '$(GITHUB_REPOSITORY)' != 'JonatanCordoba/SharpAccess'"
      Text="Stable SharpAccess packages may be produced only by JonatanCordoba/SharpAccess. Current repository identity: $(GITHUB_REPOSITORY)." />
  </Target>
</Project>

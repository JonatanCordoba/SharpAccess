<Project>
  <Import Project="$(MSBuildThisFileDirectory)eng/ProviderStatus.props" />
  <Import Project="$(MSBuildThisFileDirectory)eng/Version.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <HasGitMetadata Condition="Exists('$(MSBuildThisFileDirectory).git')">true</HasGitMetadata>
    <HasGitMetadata Condition="'$(HasGitMetadata)' == ''">false</HasGitMetadata>
    <PublishRepositoryUrl Condition="'$(HasGitMetadata)' == 'true'">true</PublishRepositoryUrl>
    <EmbedUntrackedSources Condition="'$(HasGitMetadata)' == 'true'">true</EmbedUntrackedSources>
  </PropertyGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SharpAccess.Sqlite</AssemblyName>
    <RootNamespace>SharpAccess.Sqlite</RootNamespace>
    <PackageId>SharpAccess.Sqlite</PackageId>
    <Authors>SharpAccess contributors</Authors>
    <Description>SQLite persistence provider for SharpAccess authentication and authorization on ASP.NET Core and .NET 10.</Description>
    <PackageTags>authentication;authorization;aspnetcore;dotnet;sqlite;database;security;provider</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/JonatanCordoba/SharpAccess</RepositoryUrl>
    <PackageProjectUrl>https://github.com/JonatanCordoba/SharpAccess</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable Condition="'$(SharpAccessSqliteStatus)' == 'Supported'">true</IsPackable>
    <IsPackable Condition="'$(SharpAccessSqliteStatus)' != 'Supported'">false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SharpAccess.Core/SharpAccess.Core.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/AuthStoreServiceRegistration.cs" Link="DependencyInjection/AuthStoreServiceRegistration.cs" />
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md" />
  </ItemGroup>
</Project>
